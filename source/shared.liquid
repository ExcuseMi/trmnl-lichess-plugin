{% template main %}
{%- capture ym_icon -%}{{ICON}}{%- endcapture -%}
{{PIECES}}
{%- comment -%} Framework markup only (owner 2026-11-14): layout, cards, rating, move list, QR, connect screen and title bar are
plain HTML with Framework classes, no inline styles or style blocks. Only the chessboard (data-ym-board) is drawn by the page script.
Type: heading value--small, rating value / lg:value--large, change value--xsmall, every other text label. {%- endcomment -%}
{%- assign ym_chart = "ym-spark" | append_random -%}
{%- if view == 3 %}{% assign ym_dir = "col" %}{% else %}{% assign ym_dir = "row" %}{% endif -%}
<div class="layout layout--{{ ym_dir }} layout--left layout--stretch gap--small{% if view != 4 %} lg:gap--medium{% endif %}" data-ym>
{%- if connect %}
  <div class="flex flex--col flex--center-x flex--center-y gap--medium w--full" data-ym-connect>
    <img class="image image--adaptive w--[72px] h--[72px] lg:w--[112px] lg:h--[112px]" src="data:image/svg+xml;base64,{{ ym_icon | base64_encode }}" alt="">
    <span class="title title--large">{{ t.connect_title }}</span>
    <span class="description text--center">{{ notice | default: t.connect_line }}</span>
  </div>
{%- elsif none %}
  <div class="flex flex--col flex--center-x flex--center-y gap--medium w--full" data-ym-calm data-ym-card="none">
    <img class="image image--adaptive w--[72px] h--[72px] lg:w--[112px] lg:h--[112px]" src="data:image/svg+xml;base64,{{ ym_icon | base64_encode }}" alt="">
    <span class="title title--large text--center">{{ t.none }}</span>
    <span class="description text--center">{{ calm_line | default: t.none2 }}</span>
    {%- for pr in problems %}<span class="label text--center" data-ym-problem>{{ pr }}</span>{% endfor %}
  </div>
{%- else %}
  <div class="flex flex-none" data-ym-board></div>
  <div class="flex flex--col flex--stretch-x gap--small lg:gap--medium grow" data-ym-panel>
    {%- comment -%} One stack, one gap. The move list takes the height that is left (the page script hides its oldest rows
    while the stack is too tall); without a move list the rating and QR row takes it. Panels: one style, light grey,
    white on 1-bit so no dither sits behind small text. {%- endcomment -%}
    <div class="bg--gray-75 1bit:bg--white rounded p--{% if view == 4 %}1{% else %}2{% endif %} shrink-0 flex flex--row flex--left flex--center-y gap--small" data-ym-card="turn">
      {%- if turn_w %}{% assign ym_k = ym_wK %}{% else %}{% assign ym_k = ym_bK %}{% endif %}
      <img class="image w--[32px] h--[32px] lg:w--[48px] lg:h--[48px]{% if view == 4 %} hidden{% endif %}" src="{{ ym_k }}" alt="">
      <div class="flex flex--col flex--left text--left">
        <span class="value value--small font--bold">{% if view == 4 %}{{ heading_short | default: t.your_turn }}{% else %}{{ heading | default: t.your_turn }}{% endif %}</span>
        {%- if view == 1 %}<span class="label">{{ find }}</span>{% else %}<span class="label hidden lg:visible">{% if view == 4 %}{% if turn_w %}{{ t.side_w }}{% else %}{{ t.side_b }}{% endif %}{% else %}{{ find }}{% endif %}</span>{% if meta != "" and view != 4 %}<span class="label hidden lg:visible" data-ym-meta>{{ meta }}</span>{% endif %}{% endif %}
      </div>
    </div>
    {%- if view == 1 and show_info != false %}
    <div class="bg--gray-75 1bit:bg--white rounded p--{% if view == 4 %}1{% else %}2{% endif %} shrink-0 flex flex--col flex--left text--left" data-ym-card="puzzle">
      {%- if mode == "games" %}
      <span class="label font--bold">{{ t.vs }} {{ opp_line }}</span>
      {%- if meta != "" %}<span class="label" data-ym-meta>{{ meta }}</span>{% endif %}
      {%- else %}
      <span class="label font--bold">{{ t.puzzle_n }} #{{ puzzle.id }}</span>
      {%- if meta != "" %}<span class="label" data-ym-meta>{{ meta }}</span>{% endif %}
      {%- endif %}
      {%- if mode != "games" and puzzle.game and puzzle.game.kind != "" %}
      <div class="hidden lg:flex flex--col flex--left" data-ym-game>
        <span class="label">{{ t.from_game }} {{ puzzle.game.kind }}</span>
        {%- for p in puzzle.game.players %}
        <span class="label"><svg class="inline-block" width="10" height="10" viewBox="0 0 10 10"><circle cx="5" cy="5" r="4" fill="{% if p[0] == "w" %}none{% else %}currentColor{% endif %}" stroke="currentColor" stroke-width="1.5"/></svg> {{ p[1] }}{% if p[2] > 0 %} ({{ p[2] }}){% endif %}</span>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if banner != "" %}<span class="label label--inverted font--bold">{{ banner }}</span>{% endif %}
      {%- if notice != "" or stale %}<span class="label">{{ notice | default: t.offline }}</span>{% endif %}
      {%- for pr in problems %}<span class="label" data-ym-problem>{{ pr }}</span>{% endfor %}
    </div>
    {%- endif %}
    {%- if more_line and more_line != "" %}
    <div class="bg--gray-75 1bit:bg--white rounded p--{% if view == 4 %}1{% else %}2{% endif %} shrink-0 flex flex--row flex--center-x flex--center-y" data-ym-card="more" data-ym-part="more">
      <span class="label font--bold">{% if view == 4 %}{{ more_short }}{% else %}{{ more_line }}{% endif %}</span>
    </div>
    {%- endif %}
    {%- if view == 1 and rows.size > 1 %}
    <div class="bg--gray-75 1bit:bg--white rounded p--{% if view == 4 %}1{% else %}2{% endif %} shrink-0" data-ym-card="moves">
    <table class="table table--small" data-ym-part="moves">
      <tbody>
      {%- for r in rows %}
        {%- if r.back < 4 %}
        <tr>
          <td class="bg--gray-60 1bit:bg--white text--center"><span class="label">{{ r.n }}.</span></td>
          <td><span class="label{% if r.hw %} label--inverted{% endif %}">{% if r.wp != "" %}{% case r.wp %}{% when "K" %}{% assign ym_f = ym_wK %}{% assign ym_g = ym_1wK %}{% when "Q" %}{% assign ym_f = ym_wQ %}{% assign ym_g = ym_1wQ %}{% when "R" %}{% assign ym_f = ym_wR %}{% assign ym_g = ym_1wR %}{% when "B" %}{% assign ym_f = ym_wB %}{% assign ym_g = ym_1wB %}{% else %}{% assign ym_f = ym_wN %}{% assign ym_g = ym_1wN %}{% endcase %}<img class="image image-stroke image-stroke--small inline-block 1bit:hidden w--[16px] h--[16px] lg:w--[28px] lg:h--[28px]" src="{{ ym_f }}" alt="{{ r.wp }}"><img class="image hidden 1bit:inline-block w--[18px] h--[18px]" src="{{ ym_g }}" alt="">{% endif %}{{ r.ws }}</span></td>
          <td>{% if r.bs != "" %}<span class="label{% if r.hb %} label--inverted{% endif %}">{% if r.bp != "" %}{% case r.bp %}{% when "K" %}{% assign ym_f = ym_bK %}{% assign ym_g = ym_1bK %}{% when "Q" %}{% assign ym_f = ym_bQ %}{% assign ym_g = ym_1bQ %}{% when "R" %}{% assign ym_f = ym_bR %}{% assign ym_g = ym_1bR %}{% when "B" %}{% assign ym_f = ym_bB %}{% assign ym_g = ym_1bB %}{% else %}{% assign ym_f = ym_bN %}{% assign ym_g = ym_1bN %}{% endcase %}<img class="image image-stroke image-stroke--small inline-block 1bit:hidden w--[16px] h--[16px] lg:w--[28px] lg:h--[28px]" src="{{ ym_f }}" alt="{{ r.bp }}"><img class="image hidden 1bit:inline-block w--[18px] h--[18px]" src="{{ ym_g }}" alt="">{% endif %}{{ r.bs }}</span>{% endif %}</td>
        </tr>
        {%- endif %}
      {%- endfor %}
      </tbody>
    </table>
    </div>
    {%- endif %}
    <div class="flex flex--row flex--stretch-y gap--small lg:gap--medium grow shrink-0" data-ym-bottom>
      {%- if mode == "games" %}
      <div class="bg--gray-75 1bit:bg--white rounded p--{% if view == 4 %}1{% else %}2{% endif %} flex flex--col flex--center-x flex--center-y gap--small grow" data-ym-card="time">
        {%- if time_label != "" %}<span class="label">{{ time_label }}</span>{% endif %}
        <span class="value{% if time_small %} value--small{% endif %} text--center" data-ym-part="time">{% if view == 4 %}{{ time_value_short }}{% else %}{{ time_value }}{% endif %}</span>
        {%- if view == 4 %}{% if time_sub_short != "" %}<span class="label text--center" data-ym-opp>{{ time_sub_short }}</span>{% endif %}{% elsif view != 1 and time_sub != "" %}<span class="label text--center" data-ym-opp>{{ time_sub }}</span>{% elsif time_sub_all and time_sub != "" %}<span class="label text--center" data-ym-opp>{{ time_sub }}</span>{% endif %}
      </div>
      {%- elsif account %}
      {%- comment -%} The half horizontal view's rating panel is wide and low: the rating and its week sit side by side. {%- endcomment -%}
      <div class="bg--gray-75 1bit:bg--white rounded p--{% if view == 4 %}1{% else %}2{% endif %} flex {% if view == 2 %}flex--row flex--around{% else %}flex--col{% endif %} flex--center-x flex--center-y gap--small grow" data-ym-card="rating">
        <div class="flex flex--col flex--center-x gap--xsmall">
        <span class="label">{{ t.rating_you }}</span>
        <div class="flex flex--row flex--center-y gap--small" data-ym-part="rating">
          <span class="value">{{ account.rating }}</span>
          {%- if change != "" %}<span class="value value--xsmall">{{ change }}</span>{% endif %}
        </div>
        {%- if chips.size > 0 %}
        <div class="hidden lg:flex flex--row flex--wrap flex--center-x gap--xsmall" data-ym-part="recent">
          {%- for c in chips %}{% if view == 4 and forloop.index > 2 %}{% break %}{% endif %}<span class="label {% if c.up %}label--inverted{% else %}label--outline{% endif %}">{{ c.text }}</span>{% endfor %}
        </div>
        {%- endif %}
        </div>
        {%- if view != 4 and view != 2 and account.history.size > 1 %}
        <div class="hidden lg:visible w--full h--[48px]" id="{{ ym_chart }}" data-ym-part="spark"></div>
        {%- endif %}
        {%- if view != 4 and caps.solved and days %}
        <div class="hidden lg:flex flex--col flex--center-x gap--xsmall" data-ym-part="bars">
          <span class="label text--center">{{ week_title }}<br>{{ week_line }}{% if streak_line != "" %}<br>{{ streak_line }}{% endif %}</span>
          <div class="flex flex--row flex--wrap gap--xsmall">
            {%- for d in days %}
            <div class="flex flex--col flex--center-x">
              <div class="w--[14px] h--[14px] rounded--small {% if d.on %}bg--black{% else %}bg--white{% endif %}"></div>
              <span class="label{% if d.today %} font--bold{% endif %}">{{ d.name }}</span>
            </div>
            {%- endfor %}
          </div>
        </div>
        {%- elsif view != 4 and caps.streak and account.streak > 0 %}
        <span class="label hidden lg:visible" data-ym-part="stats">{{ t.streak }} {{ account.streak }}</span>
        {%- endif %}
      </div>
      {%- endif %}
      {%- if view != 4 %}
      {%- if view == 3 %}{% assign ym_qr_og = 3 %}{% else %}{% assign ym_qr_og = 4 %}{% endif %}
      <div class="bg--gray-75 1bit:bg--white rounded p--{% if view == 4 %}1{% else %}2{% endif %} shrink-0 flex flex--col flex--center-x flex--center-y gap--xsmall {% if view == 2 %}hidden lg:flex{% endif %}" data-ym-qrbox>
        <div class="lg:hidden">{{ puzzle.url | qr_code: ym_qr_og, "m", "fixed" }}</div>
        <div class="hidden lg:visible">{% if view == 1 %}{{ puzzle.url | qr_code: 3, "m", "fixed" }}{% else %}{{ puzzle.url | qr_code: 2, "m", "fixed" }}{% endif %}</div>
        <span class="label">{{ t.scan }}</span>
      </div>
      {%- endif %}
    </div>
  </div>
{%- endif %}
</div>
{%- if view == 1 or connect %}
<div class="title_bar">
  <img class="image image--adaptive w--[28px] h--[28px]" src="data:image/svg+xml;base64,{{ ym_icon | base64_encode }}" alt="">
  <span class="title">{{ trmnl.plugin_settings.instance_name | default: "Lichess" }}</span>
  <span class="instance" data-ym-instance>{{ instance_long }}</span>
</div>
{%- endif %}
{%- unless none %}
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>
<script type="text/javascript">
var YM = { chart: "{{ ym_chart }}", view: {{ view }}, puzzle: {{ puzzle | json }}, history: {{ account.history | json }}, coords: {{ coords | json }}, white_bottom: {{ white_bottom | json }} };
// ==== DRAW
{{DRAW}}
// ==== PAGE
{{PAGE}}
</script>
{%- endunless %}
{% endtemplate %}
