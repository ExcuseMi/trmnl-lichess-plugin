{% template main %}
{%- capture ym_icon -%}{{ICON}}{%- endcapture -%}
{{PIECES}}
{%- comment -%} Framework markup only (owner 2026-11-14): layout, cards, rating, move list, QR, connect screen and title bar are
plain HTML with Framework classes, no inline styles or style blocks. Only the chessboard (data-ym-board) is drawn by the page script.
Type: heading value--small, rating value / lg:value--large, change value--xsmall, every other text label. {%- endcomment -%}
{%- assign ym_chart = "ym-spark" | append_random -%}
{%- if view == 3 %}{% assign ym_dir = "col" %}{% else %}{% assign ym_dir = "row" %}{% endif -%}
<div class="layout layout--{{ ym_dir }} layout--stretch gap--small lg:gap--medium" data-ym>
{%- if connect %}
  <div class="flex flex--col flex--center-x flex--center-y gap--medium w--full" data-ym-connect>
    <img class="image image--adaptive w--[72px] h--[72px] lg:w--[112px] lg:h--[112px]" src="data:image/svg+xml;base64,{{ ym_icon | base64_encode }}" alt="">
    <span class="title title--large">{{ t.connect_title }}</span>
    <span class="description text--center">{{ notice | default: t.connect_line }}</span>
  </div>
{%- elsif none %}
  <div class="flex flex--col flex--center-x flex--center-y gap--small w--full">
    <span class="title title--large">{{ t.none }}</span>
    <span class="description">{{ t.none2 }}</span>
  </div>
{%- else %}
  <div class="flex shrink-0" data-ym-board></div>
  <div class="flex flex--col flex--stretch-x gap--small lg:gap--medium grow" data-ym-panel>
    {%- comment -%} One stack, one gap. The move list takes the height that is left (the page script hides its oldest rows
    while the stack is too tall); without a move list the rating and QR row takes it. Panels: one style, light grey,
    white on 1-bit so no dither sits behind small text. {%- endcomment -%}
    <div class="bg--gray-75 1bit:bg--white rounded p--2 shrink-0 flex flex--row flex--left flex--center-y gap--small" data-ym-card="turn">
      {%- if turn_w %}{% assign ym_k = ym_wK %}{% else %}{% assign ym_k = ym_bK %}{% endif %}
      <img class="image w--[32px] h--[32px] lg:w--[48px] lg:h--[48px]" src="{{ ym_k }}" alt="">
      <div class="flex flex--col flex--left text--left">
        <span class="value value--small font--bold">{{ t.your_turn }}</span>
        {%- if view == 1 %}<span class="label">{{ find }}</span>{% else %}<span class="label hidden lg:visible">{{ find }}</span>{% endif %}
      </div>
    </div>
    {%- if view == 1 %}
    <div class="bg--gray-75 1bit:bg--white rounded p--2 shrink-0 flex flex--col flex--left text--left" data-ym-card="puzzle">
      <span class="label font--bold">{{ t.puzzle_n }} #{{ puzzle.id }}</span>
      {%- if meta != "" %}<span class="label" data-ym-meta>{{ meta }}</span>{% endif %}
      {%- if puzzle.game and puzzle.game.kind != "" %}
      <div class="hidden lg:flex flex--col flex--left" data-ym-game>
        <span class="label">{{ t.from_game }} {{ puzzle.game.kind }}</span>
        {%- for p in puzzle.game.players %}
        <span class="label"><svg class="inline-block" width="10" height="10" viewBox="0 0 10 10"><circle cx="5" cy="5" r="4" fill="{% if p[0] == "w" %}none{% else %}currentColor{% endif %}" stroke="currentColor" stroke-width="1.5"/></svg> {{ p[1] }}{% if p[2] > 0 %} ({{ p[2] }}){% endif %}</span>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if banner != "" %}<span class="label label--inverted font--bold">{{ banner }}</span>{% endif %}
      {%- if notice != "" or stale %}<span class="label">{{ notice | default: t.offline }}</span>{% endif %}
      {%- for pr in problems %}<span class="label" data-ym-problem>{{ pr }}</span>{% endfor %}
    </div>
    {%- endif %}
    {%- if view == 1 and rows.size > 1 %}
    <div class="bg--gray-75 1bit:bg--white rounded p--2 grow" data-ym-card="moves">
    <table class="table table--small" data-ym-part="moves">
      <tbody>
      {%- for r in rows %}
        {%- if r.back < 4 %}
        <tr>
          <td class="bg--gray-60 1bit:bg--white text--center"><span class="label">{{ r.n }}.</span></td>
          <td><span class="label{% if r.hw %} label--inverted{% endif %}">{% if r.wp != "" %}{% case r.wp %}{% when "K" %}{% assign ym_f = ym_wK %}{% when "Q" %}{% assign ym_f = ym_wQ %}{% when "R" %}{% assign ym_f = ym_wR %}{% when "B" %}{% assign ym_f = ym_wB %}{% else %}{% assign ym_f = ym_wN %}{% endcase %}<img class="image image-stroke image-stroke--small inline-block w--[16px] h--[16px] lg:w--[28px] lg:h--[28px]" src="{{ ym_f }}" alt="{{ r.wp }}">{% endif %}{{ r.ws }}</span></td>
          <td>{% if r.bs != "" %}<span class="label{% if r.hb %} label--inverted{% endif %}">{% if r.bp != "" %}{% case r.bp %}{% when "K" %}{% assign ym_f = ym_bK %}{% when "Q" %}{% assign ym_f = ym_bQ %}{% when "R" %}{% assign ym_f = ym_bR %}{% when "B" %}{% assign ym_f = ym_bB %}{% else %}{% assign ym_f = ym_bN %}{% endcase %}<img class="image image-stroke image-stroke--small inline-block w--[16px] h--[16px] lg:w--[28px] lg:h--[28px]" src="{{ ym_f }}" alt="{{ r.bp }}">{% endif %}{{ r.bs }}</span>{% endif %}</td>
        </tr>
        {%- endif %}
      {%- endfor %}
      </tbody>
    </table>
    </div>
    {%- endif %}
    <div class="flex flex--row flex--stretch-y gap--small lg:gap--medium {% if view != 1 or rows.size < 2 %}grow{% else %}shrink-0{% endif %}" data-ym-bottom>
      {%- if account %}
      <div class="bg--gray-75 1bit:bg--white rounded p--2 flex flex--col flex--center-x flex--center-y gap--xsmall grow" data-ym-card="rating">
        <span class="label">{{ t.rating_you }}</span>
        <div class="flex flex--row flex--center-y gap--small" data-ym-part="rating">
          <span class="value lg:value--large">{{ account.rating }}</span>
          {%- if change != "" %}<span class="value value--xsmall">{{ change }}</span>{% endif %}
        </div>
        {%- if view == 1 and chips.size > 0 %}
        <div class="hidden lg:flex flex--row flex--wrap flex--center-x gap--xsmall" data-ym-part="recent">
          {%- for c in chips %}<span class="label {% if c.up %}label--inverted{% else %}label--outline{% endif %}">{{ c.text }}</span>{% endfor %}
        </div>
        {%- endif %}
        {%- if view == 1 and account.history.size > 1 %}
        <div class="hidden lg:visible w--full h--[48px]" id="{{ ym_chart }}" data-ym-part="spark"></div>
        {%- endif %}
        {%- if view == 1 and caps.solved and days %}
        <div class="hidden lg:flex flex--col flex--center-x gap--xsmall" data-ym-part="bars">
          <div class="flex flex--col flex--center-x">
            <span class="label">{{ week_title }}</span>
            <span class="label">{{ week_line }}</span>
            {%- if streak_line != "" %}<span class="label">{{ streak_line }}</span>{% endif %}
          </div>
          <div class="flex flex--row flex--wrap gap--xsmall">
            {%- for d in days %}
            <div class="flex flex--col flex--center-x">
              <div class="w--[14px] h--[14px] rounded--small {% if d.on %}bg--black{% else %}bg--white{% endif %}"></div>
              <span class="label{% if d.today %} font--bold{% endif %}">{{ d.name }}</span>
            </div>
            {%- endfor %}
          </div>
        </div>
        {%- elsif view == 1 and caps.streak and account.streak > 0 %}
        <span class="label hidden lg:visible" data-ym-part="stats">{{ t.streak }} {{ account.streak }}</span>
        {%- endif %}
      </div>
      {%- endif %}
      {%- if view != 4 %}
      <div class="bg--gray-75 1bit:bg--white rounded p--2 shrink-0 flex flex--col flex--center-x flex--center-y gap--xsmall {% if view != 1 %}hidden lg:flex{% endif %}" data-ym-qrbox>
        <div class="lg:hidden">{{ puzzle.url | qr_code: 4, "m", "fixed" }}</div>
        <div class="hidden lg:visible">{{ puzzle.url | qr_code: 3, "m", "fixed" }}</div>
        <span class="label">{{ t.scan }}</span>
      </div>
      {%- endif %}
    </div>
  </div>
{%- endif %}
</div>
{%- if view == 1 or connect %}
<div class="title_bar">
  <img class="image image--adaptive w--[28px] h--[28px]" src="data:image/svg+xml;base64,{{ ym_icon | base64_encode }}" alt="">
  <span class="title">{{ trmnl.plugin_settings.instance_name | default: "Lichess" }}</span>
  <span class="instance" data-ym-instance>{{ instance_long }}</span>
</div>
{%- endif %}
{%- unless none %}
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>
<script type="text/javascript">
var YM = { chart: "{{ ym_chart }}", view: {{ view }}, puzzle: {{ puzzle | json }}, history: {{ account.history | json }}, coords: {{ coords | json }}, white_bottom: {{ white_bottom | json }} };
// ==== DRAW
{{DRAW}}
// ==== PAGE
{{PAGE}}
</script>
{%- endunless %}
{% endtemplate %}
