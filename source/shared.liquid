{% template main %}
{%- capture ym_icon -%}<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64"><path d="M29.5 3h5v5h5v5h-5v4h-5v-4h-5V8h5z"/><path d="M12 23c6-3 13-4.500 20-4.500S46 20 52 23l-6 23H18z"/><rect x="13" y="49" width="38" height="9" rx="3"/><circle cx="49" cy="47" r="14" fill="#fff"/><circle cx="49" cy="47" r="11"/><path d="M43.500 47.500l4 4 7.500-8" fill="none" stroke="#fff" stroke-width="3.600" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
<div class="layout gap--small" data-ym>
{%- if none %}
  <div class="flex flex--col flex--center-x gap--small">
    <span class="title title--large">{{ t.none }}</span>
    <span class="description">{{ t.none2 }}</span>
  </div>
{%- else %}
  <div class="flex" data-ym-board></div>
  <div class="flex flex--col" data-ym-side></div>
{%- endif %}
</div>
{%- unless none %}
<div hidden data-ym-qr>{{ puzzle.url | qr_code: 4, "m", "fixed" }}</div>
{%- endunless %}
{%- assign ym_hide = cf.hide_title_bar | append: '' -%}
{%- unless ym_hide == 'true' or ym_hide == 'yes' or view != 1 %}
<div class="title_bar">
  <img class="image image--adaptive w--[28px] h--[28px]" src="data:image/svg+xml;base64,{{ ym_icon | base64_encode }}" alt="">
  <span class="title">{{ trmnl.plugin_settings.instance_name | default: "Your Move" }}</span>
  {%- if puzzle.source == 'chesscom' %}<span class="instance">Chess.com</span>{% elsif puzzle %}<span class="instance">Lichess</span>{% endif %}
</div>
{%- endunless %}
{%- unless none %}
<script type="text/javascript">
var YM = { view: {{ view }}, puzzle: {{ puzzle | json }}, account: {{ account | json }}, caps: {{ caps | json }}, t: {{ t | json }}, to_move: {{ to_move | json }}, banner: {{ banner | json }}, notice: {{ notice | json }}, stale: {{ stale | json }}, coords: {{ coords | json }}, white_bottom: {{ white_bottom | json }} };
// ==== DRAW
{{DRAW}}
// ==== PAGE
{{PAGE}}
</script>
{%- endunless %}
{% endtemplate %}
