        <span class="value{% if time_small %} value--small{% elsif view == 2 %} value--large lg:value{% endif %} text--center" data-ym-part="time">{% if view == 4 %}{{ time_value_short }}{% else %}{{ time_value }}{% endif %}</span>
        {%- if view == 4 %}{% if time_sub_short != "" %}<span class="{{ ym_t }} text--center" data-ym-opp>{{ time_sub_short }}</span>{% endif %}{% elsif view != 1 and time_sub != "" %}<span class="{{ ym_t }} text--center" data-ym-opp>{{ time_sub }}</span>{% elsif time_sub_all and time_sub != "" %}<span class="{{ ym_t }} text--center" data-ym-opp>{{ time_sub }}</span>{% endif %}
