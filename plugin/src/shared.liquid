{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
<style>
[data-ym-panel]{height:100%;width:100%;min-height:0;align-items:stretch;justify-content:flex-start;text-align:left}
[data-ym-fill]{flex:1 1 0;min-height:0;overflow:hidden;align-self:stretch}
[data-ym-bottom]{align-items:stretch;align-self:stretch}
[data-ym-qrbox]{align-items:center;justify-content:center}
[data-ym-b],.ym-b{font-weight:700}
.ym-nw{white-space:nowrap}
[data-ym-wrap]{white-space:normal}
.ym-stretch{align-self:stretch}
.ym-rcard{min-width:9em;flex-basis:0;overflow:hidden}
[data-ym-bottom]{flex-wrap:wrap}
.screen--lg .ym-rcard{min-width:13em}
.ym-fig{display:inline-block;vertical-align:-0.22em}
.ym-mv{width:100%;border-collapse:collapse}
.ym-mv td{padding:0.12em 0.4em}
.ym-mv td.ym-n{width:2.6em;text-align:right;padding:0.12em 0.5em}
.ym-hl{display:block;border-radius:3px;padding:0 0.3em;background:#000;color:#fff}
.screen--dark-mode .ym-hl{background:#fff;color:#000}
.ym-chip{display:inline-block;border:2px solid currentColor;border-radius:6px;padding:0 0.35em}
.ym-chip--win{background:#000;color:#fff;border-color:#000}
.screen--dark-mode .ym-chip--win{background:#fff;color:#000;border-color:#fff}
</style>
<div class="layout gap--small" data-ym>
{%- if none %}
  <div class="flex flex--col flex--center-x gap--small">
    <span class="title title--large">{{ t.none }}</span>
    <span class="description">{{ t.none2 }}</span>
  </div>
{%- else %}
  <div class="flex" data-ym-board></div>
  <div class="flex flex--col" data-ym-side></div>
{%- endif %}
</div>
{%- unless none %}
<div hidden data-ym-qr>{{ puzzle.url | qr_code: 4, "m", "fixed" }}</div>
{%- endunless %}
{%- assign ym_hide = cf.hide_title_bar | append: '' -%}
{%- unless ym_hide == 'true' or ym_hide == 'yes' or view != 1 %}
<div class="title_bar">
  <img class="image image--adaptive w--[28px] h--[28px]" src="data:image/svg+xml;base64,{{ ym_icon | base64_encode }}" alt="">
  <span class="title">{{ trmnl.plugin_settings.instance_name | default: "Lichess" }}</span>
  {%- if puzzle %}<span class="instance">Puzzles</span>{% endif %}
</div>
{%- endunless %}
