    var vbq = (svgQr.getAttribute('viewBox') || '').split(/[ ,]+/), mods = Math.round((+vbq[2] || +svgQr.getAttribute('width') || 0) / 4);   // modules incl. quiet zone (the filter draws 4 units per module)
