{% template main %}
{%- assign ym_t = "label" -%}
{%- assign ym_s = "value value--small lg:value--xxsmall" -%}
{%- capture ym_icon -%}<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 45 45"><g fill="none" fill-rule="evenodd" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" transform="translate(0,0.3)"> <path d="M 22,10 C 32.5,11 38.5,18 38,39 L 15,39 C 15,30 25,32.5 23,18" fill="#000000" stroke="#000000" /> <path d="M 24,18 C 24.38,20.91 18.45,25.37 16,27 C 13,29 13.18,31.34 11,31 C 9.958,30.06 12.41,27.96 11,28 C 10,28 11.19,29.23 10,30 C 9,30 5.997,31 6,26 C 6,24 12,14 12,14 C 12,14 13.89,12.1 14,10.5 C 13.27,9.506 13.5,8.5 13.5,7.5 C 14.5,6.5 16.5,10 16.5,10 L 18.5,10 C 18.5,10 19.28,8.008 21,7 C 22,7 22,10 22,10" fill="#000000" stroke="#000000" /> <path d="M 9.5 25.5 A 0.5 0.5 0 1 1 8.5,25.5 A 0.5 0.5 0 1 1 9.5 25.5 z" fill="#ffffff" stroke="#ffffff" /> <path d="M 15 15.5 A 0.5 1.5 0 1 1 14,15.5 A 0.5 1.5 0 1 1 15 15.5 z" transform="matrix(0.866,0.5,-0.5,0.866,9.693,-5.173)" fill="#ffffff" stroke="#ffffff" /> <path d="M 24.55,10.4 L 24.1,11.85 L 24.6,12 C 27.75,13 30.25,14.49 32.5,18.75 C 34.75,23.01 35.75,29.06 35.25,39 L 35.2,39.5 L 37.45,39.5 L 37.5,39 C 38,28.94 36.62,22.15 34.25,17.66 C 31.88,13.17 28.46,11.02 25.06,10.5 L 24.55,10.4 z " fill="#ffffff" stroke="none" /> </g></svg>{%- endcapture -%}
{%- capture ym_wK -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1wK -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_wQ -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1wQ -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_wR -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1wR -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_wB -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1wB -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_wN -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1wN -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_wP -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1wP -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_bK -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1bK -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_bQ -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1bQ -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_bR -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1bR -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_bB -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1bB -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_bN -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1bN -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_bP -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- capture ym_1bP -%}data:image/svg+xml;base64,{%- endcapture -%}
{%- comment -%} Framework markup only (owner 2026-11-14): layout, cards, rating, move list, QR, connect screen and title bar are
plain HTML with Framework classes, no inline styles or style blocks. Only the chessboard (data-ym-board) is drawn by the page script.
Type: heading value--small, rating value / lg:value--large, change value--xsmall, every other text label. {%- endcomment -%}
{%- comment -%} The move list card, shared by the puzzle, Your games, Top game and Following views. {%- endcomment -%}
{%- assign ym_live = false %}{% if mode == "top" or mode == "following" %}{% assign ym_live = true %}{% endif %}
{%- assign ym_mmax = 4 %}{% if ym_live and view == 1 %}{% assign ym_mmax = 12 %}{% elsif ym_live %}{% assign ym_mmax = 3 %}{% endif %}
{%- capture ym_b_moves %}
    {%- assign ym_mv = false %}{% if view == 1 and rows.size > 1 %}{% assign ym_mv = true %}{% elsif view == 2 and ym_live and rows.size > 1 %}{% assign ym_mv = true %}{% endif %}
    {%- if ym_mv %}
    <div class="bg--gray-75 1bit:bg--white rounded p--{% if view == 4 %}1{% else %}2{% endif %} {% if ym_live %}grow{% else %}shrink-0{% endif %}" data-ym-card="moves">
    <table class="table table--small" data-ym-part="moves">
      <tbody>
      {%- for r in rows %}
        {%- if r.back < ym_mmax %}
        <tr>
          <td class="bg--gray-60 1bit:bg--white text--center"><span class="{{ ym_t }}">{{ r.n }}.</span></td>
          <td><span class="{{ ym_t }}{% if r.hw %} label--inverted{% endif %}">{% if r.wp != "" %}{% case r.wp %}{% when "K" %}{% assign ym_f = ym_wK %}{% assign ym_g = ym_1wK %}{% when "Q" %}{% assign ym_f = ym_wQ %}{% assign ym_g = ym_1wQ %}{% when "R" %}{% assign ym_f = ym_wR %}{% assign ym_g = ym_1wR %}{% when "B" %}{% assign ym_f = ym_wB %}{% assign ym_g = ym_1wB %}{% else %}{% assign ym_f = ym_wN %}{% assign ym_g = ym_1wN %}{% endcase %}<img class="image image-stroke image-stroke--small inline-block 1bit:hidden w--[16px] h--[16px] lg:w--[28px] lg:h--[28px]" src="{{ ym_f }}" data-ym-fig alt="{{ r.wp }}"><img class="image hidden 1bit:inline-block w--[18px] h--[18px]" src="{{ ym_g }}" data-ym-fig alt="">{% endif %}{{ r.ws }}</span></td>
          <td>{% if r.bs != "" %}<span class="{{ ym_t }}{% if r.hb %} label--inverted{% endif %}">{% if r.bp != "" %}{% case r.bp %}{% when "K" %}{% assign ym_f = ym_bK %}{% assign ym_g = ym_1bK %}{% when "Q" %}{% assign ym_f = ym_bQ %}{% assign ym_g = ym_1bQ %}{% when "R" %}{% assign ym_f = ym_bR %}{% assign ym_g = ym_1bR %}{% when "B" %}{% assign ym_f = ym_bB %}{% assign ym_g = ym_1bB %}{% else %}{% assign ym_f = ym_bN %}{% assign ym_g = ym_1bN %}{% endcase %}<img class="image image-stroke image-stroke--small inline-block 1bit:hidden w--[16px] h--[16px] lg:w--[28px] lg:h--[28px]" src="{{ ym_f }}" data-ym-fig alt="{{ r.bp }}"><img class="image hidden 1bit:inline-block w--[18px] h--[18px]" src="{{ ym_g }}" data-ym-fig alt="">{% endif %}{{ r.bs }}</span>{% endif %}</td>
        </tr>
        {%- endif %}
      {%- endfor %}
      </tbody>
    </table>
    </div>
    {%- endif %}
{%- endcapture %}
{%- assign ym_chart = "ym-spark" | append_random -%}
{%- if view == 3 %}{% assign ym_dir = "col" %}{% else %}{% assign ym_dir = "row" %}{% endif -%}
<div class="layout layout--{{ ym_dir }}{% if ym_dir == "row" and view == 1 %} portrait:layout--col{% endif %} layout--left layout--stretch gap--small{% if view != 4 %} lg:gap--medium{% endif %}" data-ym>
{%- if connect %}
  <div class="flex flex--col flex--center-x flex--center-y gap--medium w--full" data-ym-connect>
    <img class="image image--adaptive w--[72px] h--[72px] lg:w--[112px] lg:h--[112px]" src="data:image/svg+xml;base64,{{ ym_icon | base64_encode }}" alt="">
    <span class="title title--large">{{ t.connect_title }}</span>
    <span class="{{ ym_s }} text--center">{{ notice | default: t.connect_line }}</span>
  </div>
{%- elsif none %}
  <div class="flex flex--col flex--center-x flex--center-y gap--medium w--full" data-ym-calm data-ym-card="none">
    <img class="image image--adaptive w--[72px] h--[72px] lg:w--[112px] lg:h--[112px]" src="data:image/svg+xml;base64,{{ ym_icon | base64_encode }}" alt="">
    <span class="title title--large text--center">{% if problems.size > 0 %}{{ t.fail_title }}{% else %}{{ t.none }}{% endif %}</span>
    <span class="{{ ym_s }} text--center">{{ calm_line | default: t.none2 }}</span>
    {%- for pr in problems %}<span class="{{ ym_s }} text--center" data-ym-problem>{{ pr }}</span>{% endfor %}
  </div>
{%- elsif mode == "top" or mode == "following" %}
  {%- comment -%} Top game and Following: the board from white's side, the panel mirrors it: black's card on top, white's at the bottom of the
  moves, then the event and the QR side by side. One panel style, one gap. Quadrant: the board and the two players only. {%- endcomment -%}
  {%- if view == 4 %}{% assign ym_pp = "bg--gray-75 1bit:bg--white rounded p--1" %}{% else %}{% assign ym_pp = "bg--gray-75 1bit:bg--white rounded p--2" %}{% endif %}
  {%- for p in cards %}
  {%- assign ym_chev = "" %}{% if p.mover or view == 1 or view == 4 %}{% capture ym_chev %}<svg class="inline-block shrink-0" width="14" height="26" viewBox="0 0 14 26" data-ym-turn="{% if p.mover %}1{% else %}0{% endif %}"><polyline points="3,3 11,13 3,23" fill="none" stroke="{% if p.mover %}currentColor{% else %}none{% endif %}" stroke-width="4"/></svg>{% endcapture %}{% endif %}
  {%- capture ym_c %}
    {%- if view == 4 %}
    <div class="{{ ym_pp }} grow flex flex--col flex--center-x flex--center-y gap--xsmall" data-ym-card="player-{{ p.side }}">
      <div class="flex flex--row flex--center-y gap--xsmall">{{ ym_chev }}<svg class="inline-block shrink-0" width="10" height="10" viewBox="0 0 10 10"><circle cx="5" cy="5" r="4" fill="{% if p.black %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5"/></svg><span class="{{ ym_t }} font--bold">{{ p.short }}</span></div>
      {%- if p.clock != "" %}<span class="value value--small" data-ym-part="clock">{{ p.clock }}</span>{% endif %}
    </div>
    {%- elsif view != 1 %}
    <div class="{{ ym_pp }} shrink-0 flex flex--row flex--center-y flex--between gap--small" data-ym-card="player-{{ p.side }}">
      <div class="flex flex--row flex--left flex--center-y gap--xsmall">{{ ym_chev }}<svg class="inline-block shrink-0" width="12" height="12" viewBox="0 0 10 10"><circle cx="5" cy="5" r="4" fill="{% if p.black %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5"/></svg>{% if p.title != "" %}<span class="{{ ym_t }} label--inverted">{{ p.title }}</span>{% endif %}<span class="value value--small font--bold">{% if view == 3 %}{{ p.short }}{% else %}{{ p.name }}{% endif %}</span>{% if p.sub != "" %}<span class="{{ ym_t }}" data-ym-meta>{{ p.sub }}</span>{% endif %}</div>
      {%- if p.clock != "" %}<span class="value value--small" data-ym-part="clock">{{ p.clock }}</span>{% endif %}
    </div>
    {%- else %}
    <div class="{{ ym_pp }} shrink-0 flex flex--col flex--stretch-x gap--xsmall" data-ym-card="player-{{ p.side }}">
      <div class="flex flex--row flex--left flex--center-y gap--xsmall">{{ ym_chev }}<svg class="inline-block shrink-0" width="12" height="12" viewBox="0 0 10 10"><circle cx="5" cy="5" r="4" fill="{% if p.black %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5"/></svg>{% if p.title != "" %}<span class="{{ ym_t }} label--inverted">{{ p.title }}</span>{% endif %}<span class="value value--small font--bold">{{ p.name }}</span></div>
      <div class="flex flex--row flex--center-y flex--between gap--small"><span class="{{ ym_t }}">{{ p.sub }}</span>{% if p.clock != "" %}<span class="value value--small" data-ym-part="clock">{{ p.clock }}</span>{% endif %}</div>
    </div>
    {%- endif %}
  {%- endcapture %}
  {%- if forloop.first %}{% assign ym_card_b = ym_c %}{% else %}{% assign ym_card_w = ym_c %}{% endif %}
  {%- endfor %}
  <div class="flex flex-none portrait:w--full portrait:flex--center-x" data-ym-board></div>
  <div class="flex flex--col flex--stretch-x gap--small lg:gap--medium grow" data-ym-panel>
    {{ ym_card_b }}
    {%- if view == 1 %}{{ ym_b_moves }}{% endif %}
    {{ ym_card_w }}
    {%- if view != 4 %}
    <div class="flex flex--row flex--stretch-y gap--small lg:gap--medium{% if view != 1 %} grow{% endif %} shrink-0" data-ym-bottom>
      <div class="{{ ym_pp }} {% if view == 2 %}shrink-0{% else %}grow{% endif %} flex flex--col flex--center-y flex--left text--left gap--xsmall" data-ym-card="event">
        {%- if view == 1 %}
        <span class="{{ ym_t }}" data-ym-wrap>{{ event_name }}</span>
        {%- if round_line != "" %}<span class="{{ ym_t }}" data-ym-meta>{{ round_line }}</span>{% endif %}
        <div class="flex flex--row flex--left"><span class="{{ ym_t }} label--inverted" data-ym-part="status">{{ status_text }}</span></div>
        {%- else %}
        <div class="flex flex--row flex--left flex--center-y gap--small"><span class="{{ ym_t }} label--inverted" data-ym-part="status">{{ status_text }}</span><span class="{{ ym_t }}">{{ event_name }}</span></div>
        {%- if round_line != "" %}<span class="{{ ym_t }}" data-ym-meta>{{ round_line }}</span>{% endif %}
        {%- endif %}
      </div>
      {%- if view == 2 %}{{ ym_b_moves }}{% endif %}
      {%- if view == 3 or problems.size > 0 %}{% assign ym_qr_og = 3 %}{% else %}{% assign ym_qr_og = 4 %}{% endif %}
      <div class="{{ ym_pp }} shrink-0 flex flex--col flex--center-x flex--center-y gap--xsmall {% if view != 1 %}hidden lg:flex{% endif %}" data-ym-qrbox>
        <div class="lg:hidden">{{ puzzle.url | qr_code: ym_qr_og, "m", "fixed" }}</div>
        <div class="hidden lg:visible">{% if view == 1 %}{{ puzzle.url | qr_code: 3, "m", "fixed" }}{% else %}{{ puzzle.url | qr_code: 2, "m", "fixed" }}{% endif %}</div>
        <span class="{{ ym_t }}">{{ t.scan }}</span>
      </div>
    </div>
    {%- if problems.size > 0 %}
    <div class="{{ ym_pp }} shrink-0 flex flex--col flex--left text--left" data-ym-card="problems">
      {%- for pr in problems %}<span class="{{ ym_t }}" data-ym-problem>{{ pr }}</span>{% endfor %}
    </div>
    {%- endif %}
    {%- endif %}
  </div>
{%- elsif mode == "profile" %}
  {%- comment -%} Profile (R8): no board. Hero (the most played rating, big, 30-day change, peak, 90-day chart), the other ratings as cards
  in a grid (tiny trend each), this week (games, won/drawn/lost as one framed bar (lost white), week change, streak), recent games (packed rows). One panel style,
  one gap. Recent games are packed from the top of their panel. The hero chart and the card trends take the spare height; the page script hides, in order: the oldest recent games, the least
  played cards, the recent card. Full: header over two columns; half horizontal: hero | week and cards; half vertical: one column;
  quadrant: hero and week only. {%- endcomment -%}
  {%- if view == 4 %}{% assign ym_pp = "bg--gray-75 1bit:bg--white rounded p--1" %}{% else %}{% assign ym_pp = "bg--gray-75 1bit:bg--white rounded p--2" %}{% endif %}
  {%- assign ym_gap = "gap--small lg:gap--medium" %}{% if view == 4 %}{% assign ym_gap = "gap--small" %}{% endif %}
  {%- assign ym_h = pf.hero %}{% assign ym_w = pf.week %}
  {%- capture ym_b_name %}<div class="flex flex--row flex--left flex--center-y gap--xsmall" data-ym-part="name">{% if pf.title != "" %}<span class="{{ ym_t }} label--inverted">{{ pf.title }}</span>{% endif %}{% if view == 1 %}<span class="value value--small font--bold">{{ pf.name }}</span>{% else %}<span class="{{ ym_t }} font--bold">{{ pf.name }}</span>{% endif %}</div>{% endcapture %}
  {%- capture ym_b_head %}
    <div class="{{ ym_pp }} shrink-0 flex flex--row portrait:flex--col flex--between portrait:flex--stretch-x flex--center-y gap--small" data-ym-card="header">
      <div class="flex flex--row flex--left flex--center-y gap--small">{{ ym_b_name }}{% if pf.since != "" %}<span class="{{ ym_t }}">{{ t.member }} {{ pf.since }}</span>{% endif %}</div>
      {%- if pf.extra != "" %}<span class="{{ ym_t }}" data-ym-part="extra">{{ pf.extra }}</span>{% endif %}
    </div>
  {%- endcapture %}
  {%- capture ym_b_hero %}
    <div class="{{ ym_pp }} grow flex flex--col flex--stretch-x gap--xsmall{% unless pf.chart %} flex--center-y{% endunless %}" data-ym-card="hero">
      {%- if ym_h %}
      <div class="flex flex--row flex--between flex--center-y gap--small">
        {%- if view == 1 %}<span class="{{ ym_t }} font--bold">{{ ym_h.name }}</span>{% else %}{{ ym_b_name }}{% endif %}
        <span class="{{ ym_t }}">{% if view != 1 %}{{ ym_h.name }} · {% endif %}{{ ym_h.games_text }} {{ t.games_w }}</span>
      </div>
      <div class="flex flex--row flex--left flex--center-y gap--small" data-ym-part="hero">
        <span class="value {% if pf.chart %}lg:{% endif %}value--large font--bold">{{ ym_h.rating }}</span>{% if ym_h.prov %}<span class="{{ ym_t }}">?</span>{% endif %}
        {%- if ym_h.change != "" %}<span class="value value--xsmall">{{ ym_h.change }}</span><span class="{{ ym_t }}">{{ t.change_h }}</span>{% endif %}
      </div>
      {%- if ym_h.peak %}<span class="{{ ym_t }}" data-ym-part="peak">{{ t.peak }} {{ ym_h.peak }} · {{ ym_h.peak_when }}</span>{% endif %}
      {%- if pf.chart %}<div class="w--full grow" id="ym-spark" data-ym-part="spark"></div>{% endif %}
      {%- else %}
      {{ ym_b_name }}<span class="{{ ym_t }}">{{ t.no_recent }}</span>
      {%- endif %}
    </div>
  {%- endcapture %}
  {%- capture ym_b_week %}
    <div class="{{ ym_pp }} shrink-0 flex flex--col flex--stretch-x gap--xsmall" data-ym-card="week">
      <div class="flex flex--row flex--between flex--center-y gap--small"><span class="{{ ym_t }} font--bold">{{ t.week }}</span>{% if ym_w.n > 0 %}<span class="{{ ym_t }}">{{ ym_w.n }}{% if ym_w.more %}+{% endif %} {{ t.games_w }}</span>{% endif %}</div>
      {%- if ym_w.n > 0 %}
      <div class="label label--outline p--0 flex flex--row flex--stretch gap--none w--full h--[10px] lg:h--[12px]" data-ym-part="bar">{% for b in ym_w.bar %}<div class="grow {% if b == "W" %}bg--black{% elsif b == "D" %}bg--gray-45{% else %}bg--white{% endif %}" data-ym-seg="{{ b }}"></div>{% endfor %}</div>
      <span class="{{ ym_t }}" data-ym-part="record">{{ ym_w.won }} {{ t.won }} · {{ ym_w.drawn }} {{ t.drawn }} · {{ ym_w.lost }} {{ t.lost }}</span>
      {%- if ym_w.change != "" or ym_w.streak != "" %}<span class="{{ ym_t }}{% if view == 2 %} hidden lg:flex{% endif %}" data-ym-part="streak">{% if ym_w.change != "" %}{{ ym_w.change_name }} {{ ym_w.change }}{% if ym_w.streak != "" %} · {% endif %}{% endif %}{{ ym_w.streak }}</span>{% endif %}
      {%- else %}<span class="{{ ym_t }}">{{ t.week_none }}</span>{% endif %}
      {%- if stale %}<span class="{{ ym_t }}">{{ t.offline_pf }}</span>{% endif %}
      {%- for pr in problems %}<span class="{{ ym_t }}" data-ym-problem>{{ pr }}</span>{% endfor %}
    </div>
  {%- endcapture %}
  {%- capture ym_b_cards %}
    {%- if pf.cards.size > 0 %}
    <div class="grid grid--cols-3 {{ ym_gap }} shrink-0{% if view != 3 %} grow{% endif %}" data-ym-part="cards">
      {%- for c in pf.cards %}
      <div class="{{ ym_pp }} flex flex--col flex--stretch-x{% unless c.spark %} flex--center-y{% endunless %} gap--xsmall" data-ym-card="perf" data-ym-row data-games="{{ c.games }}">
        <div class="flex flex--row flex--between flex--center-y gap--xsmall"><span class="{{ ym_t }}">{{ c.short }}</span><span class="{{ ym_t }} hidden lg:inline-flex">{{ c.change }}</span></div>
        <div class="flex flex--row flex--left flex--center-y gap--xsmall"><span class="value value--small font--bold">{{ c.rating }}</span>{% if c.prov %}<span class="{{ ym_t }}">?</span>{% endif %}</div>
        {%- if c.spark %}<div class="w--full grow h--[20px] lg:h--[40px]" id="{{ c.spark }}" data-ym-part="trend"></div>{% endif %}
      </div>
      {%- endfor %}
    </div>
    {%- endif %}
  {%- endcapture %}
  {%- capture ym_b_recent %}
    {%- if pf.show.size > 0 %}
    <div class="{{ ym_pp }} {% if pf.cards.size == 0 %}grow{% else %}shrink-0{% endif %} flex flex--col flex--stretch-x gap--xsmall" data-ym-card="recent">
      <span class="{{ ym_t }} font--bold shrink-0">{{ t.recent }}</span>
      {%- for g in pf.show %}
      <div class="flex flex--row flex--left flex--center-y gap--small shrink-0" data-ym-game-row>
        <span class="{{ ym_t }} label--outline{% if g.c == "W" %} label--inverted{% elsif g.c == "D" %} bg--gray-60 1bit:bg--white{% endif %} flex--center w--[26px] lg:w--[40px]" data-ym-chip="{{ g.c }}">{{ g.c }}</span>
        <span class="{{ ym_t }} grow">{{ g.opp }}</span><span class="{{ ym_t }}">{{ g.tc }}</span>
      </div>
      {%- endfor %}
    </div>
    {%- endif %}
  {%- endcapture %}
  {%- assign ym_col = "flex flex--col flex--stretch-x " | append: ym_gap | append: " grow w--[0px] portrait:w--full portrait:h--[0px]" %}
  {%- if view == 1 %}
  <div class="flex flex--col flex--stretch-x {{ ym_gap }} grow" data-ym-panel>
    {{ ym_b_head }}
    <div class="flex flex--row portrait:flex--col flex--stretch-y {{ ym_gap }} grow" data-ym-cols>
      <div class="{{ ym_col }}" data-ym-panel data-ym-col>{{ ym_b_hero }}{{ ym_b_week }}</div>
      <div class="{{ ym_col }}" data-ym-panel data-ym-col>{{ ym_b_cards }}{{ ym_b_recent }}</div>
    </div>
  </div>
  {%- elsif view == 2 %}
  <div class="{{ ym_col }}" data-ym-panel data-ym-col>{{ ym_b_hero }}</div>
  <div class="{{ ym_col }}" data-ym-panel data-ym-col>{{ ym_b_week }}{{ ym_b_cards }}{% if pf.cards.size == 0 %}{{ ym_b_recent }}{% endif %}</div>
  {%- elsif view == 3 %}
  <div class="flex flex--col flex--stretch-x {{ ym_gap }} grow" data-ym-panel data-ym-col>{{ ym_b_hero }}{{ ym_b_week }}{{ ym_b_cards }}{{ ym_b_recent }}</div>
  {%- else %}
  <div class="{{ ym_col }}" data-ym-panel data-ym-col>{{ ym_b_hero }}{{ ym_b_week }}</div>
  {%- endif %}
{%- else %}
  <div class="flex flex-none portrait:w--full portrait:flex--center-x" data-ym-board></div>
  <div class="flex flex--col flex--stretch-x gap--small lg:gap--medium grow" data-ym-panel>
    {%- comment -%} One stack, one gap. The move list takes the height that is left (the page script hides its oldest rows
    while the stack is too tall); without a move list the rating and QR row takes it. Panels: one style, light grey,
    white on 1-bit so no dither sits behind small text. {%- endcomment -%}
    <div class="bg--gray-75 1bit:bg--white rounded p--{% if view == 4 %}1{% else %}2{% endif %} shrink-0 flex flex--row flex--left flex--center-y gap--small" data-ym-card="turn">
      {%- if turn_w %}{% assign ym_k = ym_wK %}{% else %}{% assign ym_k = ym_bK %}{% endif %}
      <img class="image w--[32px] h--[32px] lg:w--[48px] lg:h--[48px]{% if view == 4 %} hidden{% endif %}" src="{{ ym_k }}" data-ym-fig alt="">
      <div class="flex flex--col flex--left text--left">
        <span class="value value--small font--bold">{% if view == 4 %}{{ heading_short | default: t.your_turn }}{% else %}{{ heading | default: t.your_turn }}{% endif %}</span>
        {%- if view == 1 %}<span class="{{ ym_t }}">{{ find }}</span>{% else %}<span class="{{ ym_t }} hidden lg:visible">{% if view == 4 %}{% if turn_w %}{{ t.side_w }}{% else %}{{ t.side_b }}{% endif %}{% else %}{{ find }}{% endif %}</span>{% if meta != "" and view != 4 %}<span class="{{ ym_t }} hidden lg:visible" data-ym-meta>{{ meta }}</span>{% endif %}{% if training and training != "" and view != 4 and mode != "games" %}<span class="{{ ym_t }} hidden lg:visible" data-ym-meta data-ym-training>{{ training }}</span>{% endif %}{% endif %}
      </div>
    </div>
    {%- if view == 1 and show_info != false %}
    <div class="bg--gray-75 1bit:bg--white rounded p--{% if view == 4 %}1{% else %}2{% endif %} shrink-0 flex flex--col flex--left text--left" data-ym-card="puzzle">
      {%- if mode == "games" %}
      <span class="{{ ym_t }} font--bold">{{ t.vs }} {{ opp_line }}</span>
      {%- if meta != "" %}<span class="{{ ym_t }}" data-ym-meta>{{ meta }}</span>{% endif %}
      {%- else %}
      <span class="{{ ym_t }} font--bold">{{ t.puzzle_n }} #{{ puzzle.id }}</span>
      {%- if meta != "" %}<span class="{{ ym_t }}" data-ym-meta>{{ meta }}</span>{% endif %}
      {%- if training and training != "" %}<span class="{{ ym_t }}" data-ym-meta data-ym-training>{{ training }}</span>{% endif %}
      {%- endif %}
      {%- if mode != "games" and puzzle.game and puzzle.game.kind != "" %}
      <div class="hidden lg:flex flex--col flex--left" data-ym-game>
        <span class="{{ ym_t }}">{{ t.from_game }} {{ puzzle.game.kind }}</span>
