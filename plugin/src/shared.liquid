        <span class="{{ ym_t }}"><svg class="inline-block" width="10" height="10" viewBox="0 0 10 10"><circle cx="5" cy="5" r="4" fill="{% if p[0] == "w" %}none{% else %}currentColor{% endif %}" stroke="currentColor" stroke-width="1.5"/></svg> {{ p[1] }}{% if p[2] > 0 %} ({{ p[2] }}){% endif %}</span>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if banner != "" %}<span class="{{ ym_t }} label--inverted font--bold">{{ banner }}</span>{% endif %}
      {%- if notice != "" or stale %}<span class="{{ ym_t }}">{{ notice | default: t.offline }}</span>{% endif %}
      {%- for pr in problems %}<span class="{{ ym_t }}" data-ym-problem>{{ pr }}</span>{% endfor %}
    </div>
    {%- endif %}
